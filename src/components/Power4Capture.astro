---
import consentTexts from '../../backend/consent-texts.json';
import {captureConfig as config} from '../data/capture';import {path} from '../data/site';import '../styles/capture.css';
const consentHash=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(JSON.stringify(consentTexts)))),n=>n.toString(16).padStart(2,'0')).join('');
---
{config.enabled && <section id="capture-entry" class="capture-panel" data-preview={String(config.preview)} data-api={config.endpoint} data-sitekey={config.sitekey} data-version={config.version} data-consent-hash={consentHash} aria-labelledby="capture-title"><p class="presence-kicker">TÚ ELIGES CÓMO EMPEZAR</p><h2 id="capture-title">Tu mapa, a tu manera.</h2><p>Puedes explorar sin registro o preparar una solicitud de orientación. Tus resultados no dependen de compartir datos ni aceptar novedades.</p>{config.preview && <p class="capture-preview">Demostración local con datos sintéticos. Sin envíos reales.</p>}<div class="step-actions"><button id="capture-anonymous" type="button" class="presence-button">Continuar sin registro</button><button id="capture-register" type="button" class="presence-button">Preparar mi solicitud de orientación</button></div><form id="capture-contact" method="dialog" autocomplete="off" hidden><label>Nombre<input name="fullName" minlength="2" maxlength="120" required/></label><label>Correo<input name="email" type="email" maxlength="254" required/></label><label>Celular o WhatsApp (opcional)<input name="phone" type="tel" pattern="\+[1-9][0-9]{7,14}" placeholder="+51 seguido del número"/><small>Incluye código de país. No se enviarán mensajes automáticos a este número.</small></label><label class="capture-consent"><input name="contactConsent" type="checkbox" required/>{consentTexts.contact}</label><label class="capture-consent"><input name="marketing" type="checkbox"/>{consentTexts.marketing}</label><p><a href={path('privacidad')}>Consultar privacidad</a>. No se envía nada al continuar; confirmarás tu solicitud después de ver el mapa.</p><button type="submit" class="presence-button">Continuar al cuestionario</button></form></section>}
{config.enabled && <template id="capture-result-template"><section id="capture-send" class="capture-panel" aria-labelledby="capture-send-title"><h3 id="capture-send-title">¿Quieres compartir tu mapa?</h3><p id="capture-summary"></p><label class="capture-consent"><input id="capture-share" type="checkbox"/>{consentTexts.shareScores}</label><p>Si no marcas esta opción, enviarás solo tu consulta y datos de contacto. No se enviarán respuestas individuales.</p><div id="capture-bot"></div><button id="capture-send-button" type="button" class="presence-button">Enviar mi solicitud</button><p id="capture-status" role="status" aria-live="polite"></p></section></template>}
<script>import '../scripts/power4-capture';</script>
