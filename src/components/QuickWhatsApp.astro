---
import { whatsapp } from '../data/site';
import { socialIcons } from '../data/social-icons';
---
<a class="quick-whatsapp" href={whatsapp} aria-label="Escribir a JuanCa Power por WhatsApp">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d={socialIcons.whatsapp} /></svg>
</a>
<style>
  .quick-whatsapp {
    position: fixed;
    z-index: 9;
    inset-inline-end: max(16px, env(safe-area-inset-right));
    inset-block-end: max(16px, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    inline-size: 52px;
    block-size: 52px;
    border: 1px solid #f8f9fa;
    border-radius: 50%;
    background: #4361EE;
    color: #fff !important;
    box-shadow: 0 4px 16px #0b0d1766;
  }
  .quick-whatsapp:hover { background: #304bcf; }
  .quick-whatsapp:focus-visible { outline: 3px solid #f1e5ac; outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .quick-whatsapp { animation: quick-whatsapp-in 280ms ease-out; transition: transform 160ms ease-out, background-color 160ms ease-out; }
    .quick-whatsapp:hover { transform: scale(1.06); }
    @keyframes quick-whatsapp-in { from { transform: scale(.92); } }
  }
  :global(body:has(#consent-banner:not([hidden]))) .quick-whatsapp { visibility: hidden; }
</style>
