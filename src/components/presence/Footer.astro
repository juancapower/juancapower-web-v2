---
import {path} from '../../data/site';
const services=[['coaching','Coaching POWER 4'],['speaker','Speaker y talleres'],['contacto','Contacto']];
const legal=[['privacidad','Privacidad'],['cookies','Cookies'],['terminos','Condiciones'],['aviso-legal','Aviso legal'],['libro-de-reclamaciones','Libro de Reclamaciones']];
---
<footer class="platform-footer presence-wrap"><a href={path()} class="footer-brand">JUANCA POWER</a><p>Propósito que se convierte en acción.</p><nav aria-label="Servicios y contacto">{services.map(([url,label])=><a href={path(url)}>{label}</a>)}</nav><nav aria-label="Información legal">{legal.map(([url,label])=><a href={path(url)}>{label}</a>)}<button type="button" data-cookie-settings>Configurar cookies</button></nav><p class="footer-note">Staging · Validación previa al lanzamiento.</p></footer>
