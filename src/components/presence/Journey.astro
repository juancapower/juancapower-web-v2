---
import { path, booking, speakerContact } from '../../data/site';
import Arrow from './Arrow.astro';
import Architecture from './Architecture.astro';
import ExperienceGallery from './ExperienceGallery.astro';
import SharedStage from './SharedStage.astro';
const { live = false, approvedGallery = false } = Astro.props;
---
<section class="presence-choice" id="caminos" aria-labelledby="choice-heading">
  <div class="presence-wrap">
    <div class="chapter-heading"><p class="presence-kicker">DOS FORMAS DE TRABAJAR CONMIGO</p><h2 id="choice-heading">Tu siguiente paso.<br /><span>A tu medida.</span></h2></div>
    <div class="choice-layout">
      <article class="choice-personal"><p class="choice-audience">PARA TI</p><h3>Coaching<br />POWER 4</h3><p>Un espacio personalizado para conectar lo que quieres con lo que haces.</p><a class="presence-link" href={live ? path('coaching') : path('conceptos/wireframes/coaching')}>Explora el proceso <Arrow /></a><span class="choice-note">Orientación directa · Test opcional</span></article>
      <article class="choice-organizations"><p class="choice-audience">PARA TU ORGANIZACIÓN</p><h3>Speaker<br />y talleres</h3><p>Conferencias y experiencias que abren conversaciones y movilizan decisiones.</p><a class="presence-link" href={path(live ? 'speaker' : 'conceptos/wireframes/speaker')}>Conversemos sobre tu evento <Arrow /></a><span class="choice-note">Objetivo · Público · Formato</span></article>
    </div>
  </div>
</section>
<section class="presence-method" id="power4" aria-labelledby="power-title"><div class="presence-wrap method-layout"><div class="method-copy"><p class="presence-kicker">EL MÉTODO · POWER 4</p><h2 id="power-title">Una vida alineada<br />se construye<br /><span>desde la base.</span></h2><p>Espíritu y Mente dan dirección. Cuerpo y Emoción sostienen el camino. Plenitud y Abundancia forman el horizonte.</p><a class="presence-link" href={live ? booking : path('conceptos/wireframes/coaching')}>{live ? 'Agenda una sesión de orientación' : 'Conoce cómo acompañarte'} <Arrow /></a></div><Architecture /></div></section>
{approvedGallery ? <ExperienceGallery /> : <section class="presence-experience" id="experiencia" aria-labelledby="experience-title"><div class="presence-wrap"><div class="experience-top"><p class="presence-kicker">PERSONAS. CONVERSACIONES. ACCIÓN.</p><h2 id="experience-title">La presencia<br />también se comparte.</h2><p>En el escenario y en el trabajo con equipos, el punto de partida sigue siendo humano.</p></div><div class="experience-photos"><figure class="experience-workshop"><img src={`${path()}images/presence/workshop-1200.webp`} alt="Participantes de un encuentro corporativo en un espacio de trabajo, fotografiados desde el fondo de la sala." width="1200" height="900" loading="lazy" /><figcaption>Trabajo con equipos · Fotografía de archivo personal</figcaption></figure><figure class="experience-audience"><img src={`${path()}images/presence/audience-720.webp`} alt="Vista de un auditorio con asistentes y JuanCa Power en el escenario." width="720" height="1280" loading="lazy" /><figcaption>Escenario · Encuentro presencial</figcaption></figure></div></div></section>}
{approvedGallery && <SharedStage />}
<section class="presence-close"><div class="presence-wrap"><p class="presence-kicker">EMPIEZA POR UNA CONVERSACIÓN</p><h2>El siguiente paso<br />lo decides tú.</h2><div class="presence-actions"><a class="presence-button" href={booking}>Agenda una sesión de orientación <Arrow /></a><a class="presence-link" href={speakerContact}>Contrátame como speaker <Arrow /></a></div><p class="presence-disclosure">Google Calendar para orientación · WhatsApp para conferencias</p></div></section>
{!live && <footer class="presence-footer presence-wrap"><span>JUANCA POWER</span><p>Propósito que se convierte en acción.</p><a href={path('conceptos')}>Volver a las direcciones <Arrow /></a></footer>}
