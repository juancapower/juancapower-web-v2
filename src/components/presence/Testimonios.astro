---
import { path } from '../../data/site';

const stories = [
  {
    "name": "Ybeth",
    "role": "Maestra de Inicial",
    "key": "ybeth",
    "v": "1775667361",
    "id": "Testimonio_YbethA_hjhhsw"
  },
  {
    "name": "Fiorella",
    "role": "Ingeniera Industrial",
    "key": "fiorella",
    "v": "1775667359",
    "id": "Testimonio_FiorellaS_k6drko"
  },
  {
    "name": "Karen",
    "role": "CEO de Warmi Kapital",
    "key": "karen",
    "v": "1775667359",
    "id": "Testimonio_KarenG_fkgzkm"
  },
  {
    "name": "Gabriela",
    "role": "",
    "key": "gabriela",
    "v": "1775667359",
    "id": "Testimonio_GabrielaV_zpq676"
  },
  {
    "name": "Álvaro",
    "role": "Líder de tecnología",
    "key": "alvaro",
    "v": "1775667358",
    "id": "Testimonio_AlvaroV_u1liet"
  }
];
const media = 'https://res.cloudinary.com/ddn6qh7ve/video/upload';
---
<section class="home-stories" aria-labelledby="stories-title">
  <div class="presence-wrap">
    <h2 id="stories-title">Historias que hablan <span>por sí solas.</span></h2>
    <div class="story-layout" data-story-carousel>
      <div class="story-stage">
        {stories.map(({ name, role, key, v, id }, index) => (
          <article class="story" hidden={index !== 0}>
            <div class="story-media">
              <video controls playsinline preload="none" aria-label={`Testimonio de ${name}`}
              poster={path() + 'images/testimonios/' + key + '.webp'}
              src={`${media}/v${v}/${id}.mp4`}>
                <track kind="captions" srclang="es" label="Español" src={path() + 'captions/testimonios/' + key + '.vtt'} />
              </video>
              <p class="story-status" role="status"></p>
            </div>
            <div class="story-person"><h3>{name}</h3>{role && <p>{role}</p>}</div>
          </article>
        ))}
      </div>
      <div class="story-rail">
        <div class="story-controls" hidden>
          <p class="story-counter" aria-live="polite">01 / 05</p>
          <button type="button" data-story-step="-1" aria-label="Testimonio anterior">←</button>
          <button type="button" data-story-step="1" aria-label="Testimonio siguiente">→</button>
        </div>
        <div class="story-thumbs" hidden>
          {stories.map(({ name, key }, index) => (
            <button type="button" data-story-index={index} aria-label={`Ver testimonio de ${name}`} aria-pressed={index === 0}>
              <img src={path() + 'images/testimonios/' + key + '.webp'} alt="" width="72" height="128" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  for (const carousel of document.querySelectorAll('[data-story-carousel]')) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('.story')];
    const thumbs = [...carousel.querySelectorAll<HTMLButtonElement>('[data-story-index]')];
    const counter = carousel.querySelector('.story-counter')!;
    let current = 0;

    function select(index: number) {
      if (index === current) return;
      slides[current].querySelector('video')?.pause();
      slides[current].hidden = true;
      thumbs[current].setAttribute('aria-pressed', 'false');
      current = index;
      slides[current].hidden = false;
      thumbs[current].setAttribute('aria-pressed', 'true');
      counter.textContent = String(current + 1).padStart(2, '0') + ' / ' + String(slides.length).padStart(2, '0');
    }

    for (const slide of slides) {
      const video = slide.querySelector('video')!;
      const status = slide.querySelector('.story-status')!;
      video.addEventListener('waiting', () => { status.textContent = 'Cargando video…'; });
      video.addEventListener('error', () => { status.textContent = 'No se pudo cargar el video.'; });
      for (const event of ['playing', 'pause', 'ended']) {
        video.addEventListener(event, () => { status.textContent = ''; });
      }
    }
    thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => select(index)));
    for (const button of carousel.querySelectorAll<HTMLButtonElement>('[data-story-step]')) {
      button.addEventListener('click', () => select((current + Number(button.dataset.storyStep) + slides.length) % slides.length));
    }
    for (const group of carousel.querySelectorAll<HTMLElement>('.story-thumbs, .story-controls')) group.hidden = false;
  }
</script>
<style>
  .home-stories { padding-block: clamp(52px, 7vw, 100px); background: #0b0d17; }
  h2 { font-size: clamp(2rem, 5vw, 4rem); letter-spacing: -.05em; line-height: 1.05; margin-bottom: clamp(22px, 4vw, 42px); text-wrap: balance; }
  h2 span, .story-counter { color: #f1e5ac; }
  .story-layout {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto 1fr; gap: 12px clamp(24px, 6vw, 88px);
    background: #121622; border: 1px solid #343b50; border-radius: 8px;
    padding: clamp(16px, 4vw, 48px);
  }
  .story-stage, .story { display: contents; }
  .story-media { position: relative; grid-column: 1; grid-row: 1 / 4; align-self: center; justify-self: center; width: min(100%, 320px); }
  video { display: block; width: 100%; aspect-ratio: 9/16; background: #0b0d17; object-fit: contain; border-radius: 6px; }
  .story-status { position: absolute; inset: auto 12px 52px; padding: 6px 10px; background: #0b0d17; color: #f8f9fa; pointer-events: none; }
  .story-status:empty { padding: 0; }
  .story-person { grid-column: 2; grid-row: 2; }
  .story-person p { color: #b7bdce; }
  .story-person h3 { margin-bottom: 8px; font-size: clamp(2rem,4vw,3.6rem); line-height: 1.05; letter-spacing: -.045em; }
  .story-rail { grid-column: 2; grid-row: 3; min-width: 0; align-self: start; }
  .story-controls { display: flex; align-items: center; gap: 8px; margin: 12px 0 14px; }
  .story-controls button { width: 44px; height: 44px; border-radius: 50%; font-size: 1.2rem; }
  .story-controls button:last-child { background: #f1e5ac; color: #0b0d17; border-color: #f1e5ac; }
  .story-counter { margin-right: 12px; font-variant-numeric: tabular-nums; }
  .story-thumbs { display: grid; grid-template-columns: repeat(5,minmax(0, 62px)); gap: 6px; }
  button { cursor: pointer; color: #f8f9fa; background: #121622; border: 1px solid #667084; }
  button:hover, button[aria-pressed="true"] { border-color: #f1e5ac; }
  button[aria-pressed="true"] { box-shadow: inset 0 0 0 1px #f1e5ac; }
  :is(button, video):focus-visible { outline: 3px solid #f1e5ac; outline-offset: 3px; }
  .story-thumbs button { padding: 2px; min-height: 44px; border-radius: 6px; }
  .story-thumbs img { display: block; width: 100%; height: auto; aspect-ratio: 9/16; object-fit: cover; border-radius: 4px; }
  @media (max-width: 700px) {
    .story-layout { grid-template-columns: minmax(0,1fr); grid-template-rows: auto; }
    .story-media { grid-area: 1 / 1; width: min(100%, 270px); }
    .story-person { grid-area: 2 / 1; }
    .story-rail { grid-area: 3 / 1; }
    .story-person h3 { margin-bottom: 4px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .story:not([hidden]) :is(.story-media, .story-person) { animation: story-in 220ms ease-out; }
    @keyframes story-in { from { opacity: .83; transform: translateY(3px); } }
  }
</style>