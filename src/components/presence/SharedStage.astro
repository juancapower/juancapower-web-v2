---
import { path, speakerContact } from '../../data/site';

const photographs = [
  { name: 'Orlando Denegri', file: 'orlando-denegri', width: 585, height: 1040, focus: '50% 20%', closed: '37% 20%', alt: 'JuanCa Power y Orlando Denegri posan juntos frente a una proyección.' },
  { name: 'Stefanny Berdejo', file: 'stefanny-berdejo', width: 960, height: 1280, focus: '49% 21%', closed: '54% 21%', alt: 'JuanCa Power y Stefanny Berdejo sonríen frente a una pantalla oscura.' },
  { name: 'Wilfredo Guevara (WIGO Éxito)', file: 'wilfredo-guevara', width: 960, height: 1280, focus: '52% 4%', closed: '57% 4%', alt: 'JuanCa Power y Wilfredo Guevara posan juntos junto a una pared de madera.' },
  { name: 'Daniela Sarfati', file: 'daniela-sarfati', width: 3000, height: 4000, focus: '50% 37%', closed: '45% 37%', alt: 'JuanCa Power y Daniela Sarfati posan juntos al aire libre.' },
  { name: 'Dr. Bayter', file: 'dr-bayter', width: 1086, height: 1448, focus: '50% 12%', closed: '44% 12%', alt: 'JuanCa Power y el Dr. Bayter posan juntos en un espacio interior.' },
  { name: 'Héctor Raúl González', file: 'hector-raul-gonzalez', width: 1126, height: 1500, focus: '48% 21%', closed: '46% 21%', alt: 'JuanCa Power y Héctor Raúl González sonríen juntos en una terraza.' },
  { name: 'Jorge Loza', file: 'jorge-loza', width: 960, height: 1280, focus: '44% 24%', closed: '39% 24%', alt: 'JuanCa Power y Jorge Loza posan ante el cartel «Libera tu propósito».' },
];

const otherNames = ['Ana Pierr', 'Regina Carrot', 'Rita Denegri', 'Gisela Rosales'];
const imageDirectory = path('images/shared-stage/');
---

<section class="shared-stage" id="escenarios-compartidos" aria-labelledby="shared-stage-title">
  <div class="presence-wrap">
    <header class="stage-heading">
      <p class="presence-kicker">UN RECORRIDO DE ENCUENTROS</p>
      <h2 id="shared-stage-title">He compartido <span>escenario con...</span></h2>
      <p>Encuentros de mi recorrido como speaker, en escenarios y fuera de ellos.</p>
    </header>

    <p class="gallery-hint" id="shared-stage-hint">
      <span class="hint-touch">Desliza para ver más fotografías.</span>
      <span class="hint-desktop">Selecciona una fotografía para ampliarla.</span>
    </p>
    <div class="stage-gallery" role="region" aria-label="Galería de encuentros" aria-describedby="shared-stage-hint" tabindex="0">
      <ul class="stage-frames" role="list">
        {photographs.map(({ name, file, width, height, focus, closed, alt }, index) => (
          <li class="stage-frame" style={`--photo-focus: ${focus}; --photo-closed: ${closed}`}>
            <figure>
              <img
                src={`${imageDirectory}${file}-720.webp`}
                srcset={`${imageDirectory}${file}-360.webp 360w, ${imageDirectory}${file}-720.webp ${Math.min(width, 720)}w`}
                sizes={`(min-width: 1100px) ${index === 0 ? 570 : 240}px, (min-width: 680px) 42vw, 80vw`}
                width={width}
                height={height}
                alt={alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{name}</figcaption>
            </figure>
            <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <button class="stage-select" type="button" aria-label={name} aria-pressed={index === 0}></button>
          </li>
        ))}
      </ul>
    </div>

    <div class="stage-mentions">
      <h3>También he compartido escenario con</h3>
      <ul class="shared-stage-names" role="list">
        {otherNames.map(name => <li>{name}</li>)}
      </ul>
    </div>

    <div class="stage-footer">
      <p>Compartir escenario no implica aval de mis servicios ni una alianza comercial.</p>
      <a class="presence-link" href={speakerContact}>Hablemos de tu próximo evento <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('.stage-gallery');
  if (gallery) {
    const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.stage-select'));
    const desktop = matchMedia('(min-width: 1100px)');

    function select(index: number) {
      buttons.forEach((button, position) => {
        const active = position === index;
        button.setAttribute('aria-pressed', String(active));
        const photo = button.parentElement?.querySelector('img');
        if (photo) photo.sizes = `(min-width: 1100px) ${active ? 570 : 240}px, (min-width: 680px) 42vw, 80vw`;
      });
    }

    function updateLayout() {
      gallery?.toggleAttribute('data-expandable', desktop.matches);
      gallery?.setAttribute('tabindex', desktop.matches ? '-1' : '0');
    }

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(index));
      button.addEventListener('keydown', event => {
        let target: number;
        switch (event.key) {
          case 'ArrowLeft': target = Math.max(0, index - 1); break;
          case 'ArrowRight': target = Math.min(buttons.length - 1, index + 1); break;
          case 'Home': target = 0; break;
          case 'End': target = buttons.length - 1; break;
          default: return;
        }
        event.preventDefault();
        select(target);
        buttons[target].focus({ preventScroll: true });
      });
    });

    updateLayout();
    desktop.addEventListener('change', updateLayout);
  }
</script>

<style>
  .shared-stage {
    background: var(--presence-bg);
    color: var(--presence-white);
    border-bottom: 1px solid var(--presence-line);
    padding: clamp(64px, 7vw, 100px) 0;
  }

  .stage-heading h2 {
    font-size: clamp(2.125rem, 4.8vw, 4.25rem);
    line-height: 1.1;
    letter-spacing: -.06em;
    margin: 16px 0;
  }

  .stage-heading h2 span { color: var(--presence-gold); }
  .stage-heading > p:last-child { color: var(--presence-muted); max-width: 56ch; line-height: 1.65; margin: 0; }

  .gallery-hint {
    color: var(--presence-muted);
    font-size: .8125rem;
    margin: 32px 0 12px;
  }

  .stage-gallery {
    overflow-x: auto;
    scrollbar-color: var(--presence-muted) #121622;
    scroll-snap-type: x mandatory;
  }

  .stage-gallery:focus-visible { outline: 3px solid var(--presence-gold); outline-offset: 4px; }

  .stage-frames {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
  }

  .stage-frame {
    position: relative;
    flex: 0 0 85%;
    min-width: 0;
    height: clamp(320px, 98vw, 430px);
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid var(--presence-line);
    border-radius: 4px;
    background: #121622;
  }

  .stage-frame figure { margin: 0; }
  .stage-frame img, .stage-frame figure::after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage-frame img { object-fit: cover; object-position: var(--photo-focus); }
  .stage-frame figure::after {
    content: '';
    background: linear-gradient(0deg, #0b0d17 0%, #0b0d17e6 12%, #0b0d1700 48%);
  }

  .stage-frame figcaption {
    position: absolute;
    z-index: 1;
    bottom: 20px;
    inset-inline: 16px;
    color: var(--presence-white);
    font-size: clamp(1.0625rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -.025em;
    line-height: 1.2;
  }

  .stage-number, .stage-select, .hint-desktop { display: none; }

  .stage-mentions { margin-top: 36px; }
  .stage-mentions h3 { margin: 0 0 14px; color: var(--presence-gold); font-size: .875rem; font-weight: 600; }
  .shared-stage-names {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shared-stage-names li {
    border-top: 1px solid var(--presence-line);
    padding: 13px 0;
    font-size: clamp(.95rem, 1.55vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -.025em;
  }

  .stage-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; margin-top: 20px; }
  .stage-footer p { color: var(--presence-muted); font-size: .8125rem; margin: 0; }
  .stage-footer .presence-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }

  @media (min-width: 680px) {
    .stage-frame { flex-basis: 43%; height: 390px; }
    .shared-stage-names { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .stage-frame { flex-basis: 34%; }
    .shared-stage:has([data-expandable]) .hint-desktop { display: inline; }
    .shared-stage:has([data-expandable]) .hint-touch { display: none; }
    .stage-gallery[data-expandable] { overflow: visible; scroll-snap-type: none; }
    [data-expandable] .stage-frames { padding: 0; }
    [data-expandable] .stage-frame {
      flex: 1 1 0;
      height: clamp(390px, 34vw, 460px);
      transition: flex-grow 420ms cubic-bezier(.22, .72, .22, 1), border-color 180ms ease-out;
    }

    [data-expandable] .stage-frame:has([aria-pressed="true"]) { flex-grow: 5.2; border-color: var(--presence-gold); }
    [data-expandable] .stage-frame img {
      object-position: var(--photo-closed);
      filter: saturate(.55) brightness(.83);
      transition: filter 420ms ease-out, object-position 420ms ease-out;
    }

    [data-expandable] .stage-frame:has([aria-pressed="true"]) img {
      object-position: var(--photo-focus);
      filter: none;
    }

    [data-expandable] .stage-frame:not(:has([aria-pressed="true"])) figcaption { visibility: hidden; opacity: 0; }
    [data-expandable] .stage-frame figcaption { bottom: 24px; inset-inline: 22px; transition: opacity 220ms ease-out; }
    [data-expandable] .stage-frame:has([aria-pressed="true"]) figcaption { transition-delay: 110ms; }

    [data-expandable] .stage-number {
      position: absolute;
      z-index: 1;
      top: 12px;
      left: 12px;
      display: grid;
      place-items: center;
      width: 32px;
      height: 28px;
      border-radius: 2px;
      background: var(--presence-bg);
      color: var(--presence-gold);
      font-size: .6875rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    [data-expandable] .stage-select {
      position: absolute;
      z-index: 2;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      padding: 0;
      background: transparent;
      cursor: pointer;
    }

    [data-expandable] .stage-frame:has(.stage-select:hover) { border-color: var(--presence-blue); }
    [data-expandable] .stage-select:focus-visible { outline: 3px solid var(--presence-gold); outline-offset: -5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-gallery *, .stage-gallery { transition: none !important; scroll-behavior: auto !important; }
  }
</style>
