---
import Concept from '../../layouts/Concept.astro';
import Header from '../../components/presence/Header.astro';
import StageHero from '../../components/presence/StageHero.astro';
import photos from '../../data/gallery.json';
import {path,speakerContact} from '../../data/site';
export function getStaticPaths(){return ['a','b'].map(option=>({params:{option}}));}
const {option}=Astro.params;
const selected=['en-escena','dinamica','en-equipo'].map(slug=>photos.find(p=>p.slug===slug));
---
<Concept title={`Galería ${option.toUpperCase()} · revisión`} showReview={false}><Header live/><main id="contenido" tabindex="-1"><StageHero live/><section class:list={['presence-experience','review-gallery',option]}><div class="presence-wrap"><p class="presence-kicker">{option==='a'?'A · ESCENARIO PROTAGONISTA':'B · PORTAFOLIO EDITORIAL'} · PROPUESTA SIN PUBLICAR</p><div class="experience-top"><h2>La presencia<br/>también se comparte.</h2><p>Una idea abre la conversación. La interacción la lleva al equipo.</p></div><div class="photo-story">{selected.map(p=><figure><img src={`${path()}images/gallery/${p.slug}-${p.variants.at(-1)}.webp`} width={p.width} height={p.height} alt={p.alt} loading="lazy"/><figcaption>{p.caption}</figcaption></figure>)}</div><div class="gallery-next"><a class="presence-button" href={speakerContact}>Conversemos sobre tu evento ↗</a></div></div></section></main></Concept>
<style is:global>
.review-gallery{background:#F5F3ED;color:#0B0D17}.review-gallery .presence-kicker{color:#535B6C}.photo-story{display:grid;gap:24px;margin-top:40px;grid-template-columns:1fr 1fr}.photo-story figure{margin:0}.photo-story img{width:100%;height:100%;object-fit:cover}.photo-story figcaption{font-size:12px;color:#535B6C;margin-top:10px}.a .photo-story figure:first-child{grid-column:1/-1}.a .photo-story figure:first-child img{aspect-ratio:16/9;height:auto}.a .photo-story figure:not(:first-child) img{height:340px;object-position:center 48%}.b .photo-story{grid-template-columns:1.6fr 1fr;gap:24px}.b .photo-story figure:first-child{grid-row:span 2}.b .photo-story figure:first-child img{height:660px;object-position:53% center}.b .photo-story figure:not(:first-child) img{height:300px}.review-gallery .gallery-next{margin-top:56px}@media(max-width:700px){.photo-story,.b .photo-story{grid-template-columns:1fr;gap:32px}.b .photo-story figure:first-child{grid-row:auto}.b .photo-story figure:first-child img{height:310px}.a .photo-story figure:not(:first-child) img,.b .photo-story figure:not(:first-child) img{height:240px}.review-gallery .experience-top{display:block}}
</style>
