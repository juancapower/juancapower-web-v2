---
import Platform from '../layouts/Platform.astro';import {path} from '../data/site';import Architecture from '../components/presence/Architecture.astro';import {resources} from '../data/resources';
---
<Platform title="Recursos gratuitos · JuanCa Power" description="Explora el Mapa POWER 4 y el Kit de Marca Personal disponible en la biblioteca original."><section class="platform-hero presence-wrap"><div><p class="presence-kicker">EXPLORA · REFLEXIONA · APLICA</p><h1>Una idea útil.<br/><span>Un paso posible.</span></h1><p>Herramientas para explorar tu autopercepción y trabajar tu marca personal. Elige por dónde empezar.</p></div></section><section class="platform-section platform-light"><div class="presence-wrap resource-list">{resources.map((r,index)=><article class="resource-feature"><div class="resource-image">{r.route ? <div class="resource-diagram"><Architecture/></div> : <img src={`${path()}${r.image}`} alt="Portada del Kit de Marca Personal de JuanCa Power" width={r.width} height={r.height} loading="lazy"/>}</div><div><p class="presence-kicker">0{index+1} · {r.kind}</p><h2>{r.title}</h2><p>{r.description}</p><a class="presence-button" href={r.url || path(r.route)}>Explorar {r.title} ↗</a>{r.url && <p class="resource-note">Abre la biblioteca original, que tiene sus propias condiciones.</p>}</div></article>)}</div></section></Platform>
