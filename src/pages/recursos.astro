---
import Platform from '../layouts/Platform.astro';import {path} from '../data/site';import {resources} from '../data/resources';
---
<Platform title="Recursos gratuitos · JuanCa Power" description="Explora el Mapa POWER 4 y el Kit de Marca Personal disponible en la biblioteca original."><section class="platform-hero presence-wrap"><div><p class="presence-kicker">EXPLORA · REFLEXIONA · APLICA</p><h1>Una idea útil.<br/><span>Un paso posible.</span></h1><p>Elige una herramienta y empieza desde tu propia situación. Sin descargas ficticias ni registro para explorar el Mapa POWER 4.</p></div></section><section class="platform-section platform-light"><div class="presence-wrap resource-list">{resources.map((r,index)=><article class="resource-feature"><div class="resource-image"><img src={`${path()}${r.image}`} alt={index===0?'JuanCa Power junto a una pizarra durante un taller':'JuanCa Power presentando en un escenario'} width={r.width} height={r.height} loading="lazy"/></div><div><p class="presence-kicker">0{index+1} · {r.kind}</p><h2>{r.title}</h2><p>{r.description}</p><a class="presence-button" href={r.url || path(r.route)}>Explorar {r.title} ↗</a>{r.url && <p class="resource-note">Abre la biblioteca original, que tiene sus propias condiciones.</p>}</div></article>)}</div></section></Platform>
