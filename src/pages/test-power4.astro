---
import Power4Capture from '../components/Power4Capture.astro';import {captureConfig} from '../data/capture';
import Platform from '../layouts/Platform.astro';import legacyQuestions from '../data/power4.json';import localQuestions from '../data/power4-local.json';import {booking} from '../data/site';
const questions=(captureConfig.preview ? legacyQuestions : localQuestions) as [string,string[]][];
---
<Platform title="Mapa POWER 4 · Evaluación de Alineación Personal" description="Doce afirmaciones de autopercepción con resultados locales y sin registro."><section class="platform-hero presence-wrap test-intro"><div><p class="presence-kicker">AUTOPERCEPCIÓN · SIN REGISTRO</p><h1>Tu momento.<br/><span>Tu mapa POWER 4.</span></h1><p>Considera las últimas dos semanas. Responde de 1 (muy poco) a 5 (mucho). Es una herramienta de reflexión, no un diagnóstico ni un instrumento científico validado.</p><a class="presence-button" href={booking}>Reservar orientación sin hacer el test ↗</a></div></section><section class="platform-section platform-light"><div class="presence-wrap test-questions"><Power4Capture/><noscript><p>El cálculo necesita JavaScript local. No se envían respuestas; puedes reservar orientación directamente desde el enlace de arriba.</p></noscript><form id="power-form" hidden={captureConfig.enabled} method="dialog" autocomplete="off" novalidate><div id="step-progress" hidden><p id="step-label" tabindex="-1"></p><progress id="step-meter" max="4" value="1" aria-label="Progreso de la evaluación"></progress><p id="step-error" role="alert"></p></div><ul class="power-scale" aria-label="Escala de respuestas"><li>1 · Muy poco</li><li>2 · Poco</li><li>3 · Moderadamente</li><li>4 · Bastante</li><li>5 · Mucho</li></ul>{questions.map(([dimension,items],group)=><section class="power-step" aria-label={dimension}><h2>{dimension}</h2>{items.map((question,index)=><fieldset><legend>{question}</legend>{[1,2,3,4,5].map(value=><label class="test-answer"><input type="radio" name={`q${group*items.length+index}`} value={value} required/><span>{value}</span></label>)}</fieldset>)}</section>)}<div class="step-actions"><button id="previous-step" class="presence-button" type="button" hidden>Anterior</button><button id="next-step" class="presence-button" type="button" hidden>Siguiente</button><button id="show-map" class="presence-button" type="submit" disabled>Ver mi mapa POWER 4</button></div></form><section id="power-result" hidden tabindex="-1" aria-labelledby="result-title"><h2 id="result-title">Tu mapa de hoy</h2>{captureConfig.preview ? <p>Rangos orientativos no clínicos ni psicométricamente validados: 4–9, área para explorar; 10–14, en desarrollo; 15–20, fortaleza percibida. No definen quién eres ni predicen resultados.</p> : <p>Estos índices de autopercepción no están validados. No son diagnósticos ni porcentajes científicos de bienestar.</p>}<p id="score-summary"></p><div id="scores"></div><p>Elige una dimensión y pregúntate: ¿qué acción pequeña y realista quiero explorar esta semana?</p><h3 id="power4-conversion">¿Quieres convertir este mapa en un plan personalizado?</h3><a class="presence-button" href={booking}>Agenda tu sesión POWER 4 ↗</a><p><button id="repeat" class="presence-button" type="button">Repetir el test</button></p></section><p>{captureConfig.enabled ? 'Las respuestas individuales se calculan aquí y no se envían. Los datos de contacto y los cuatro puntajes solo se comparten al confirmar tu solicitud y la autorización correspondiente. Puedes reservar sin enviar nada.' : 'Las respuestas se procesan solo en esta página y se eliminan al recargar. No se envían ni guardan. La reserva siempre es opcional y directa.'}</p></div></section></Platform>
<script>
const form=document.querySelector<HTMLFormElement>('#power-form')!;
const result=document.querySelector<HTMLElement>('#power-result')!;
const steps=[...form.querySelectorAll<HTMLElement>('.power-step')];
const previous=document.querySelector<HTMLButtonElement>('#previous-step')!;
const next=document.querySelector<HTMLButtonElement>('#next-step')!;
const submit=document.querySelector<HTMLButtonElement>('#show-map')!;
const label=document.querySelector<HTMLElement>('#step-label')!;
const error=document.querySelector<HTMLElement>('#step-error')!;
let current=0;
form.reset();submit.disabled=false;
function showStep(focus=true){steps.forEach((s,i)=>s.hidden=i!==current);previous.hidden=current===0;next.hidden=current===3;submit.hidden=current!==3;label.textContent=`Paso ${current+1} de 4 · ${steps[current].getAttribute('aria-label')}`;(document.querySelector('#step-meter') as HTMLProgressElement).value=current+1;error.textContent='';if(focus)label.focus()}
function validate(){const fields=[...steps[current].querySelectorAll('fieldset')];const missing=fields.find(f=>!f.querySelector('input:checked'));if(missing){error.textContent='Responde todas las afirmaciones para continuar. Puedes volver al paso anterior sin perder tus respuestas.';missing.querySelector('input')!.focus();return false}return true}
document.querySelector<HTMLElement>('#step-progress')!.hidden=false;showStep(false);
next.addEventListener('click',()=>{if(validate()){current++;showStep()}});
previous.addEventListener('click',()=>{current--;showStep()});
const suggestions = [
  ['Reserva un momento de silencio o reflexión.', 'Identifica un valor que pueda orientar tu próxima decisión.', 'Nombra una actividad que le dé sentido a tu semana.'],
  ['Define qué quieres lograr, cuándo y cómo lo medirás.', 'Identifica una creencia y considera otra forma de interpretar la situación.', 'Elige algo concreto que quieras aprender esta semana.'],
  ['Observa qué hábitos favorecen tu descanso.', 'Elige una forma de movimiento que puedas incorporar a tu día.', 'Revisa qué hábito alimentario cotidiano quieres cuidar.'],
  ['Practica decir «Me siento…» y expresar una necesidad con respeto.', 'Identifica una forma saludable de recuperar la calma.', 'Elige una relación que quieras cuidar con una acción concreta.'],
];
form.addEventListener('submit', event => {
  event.preventDefault();
  if (!validate()) return;
  const data = new FormData(form);
  const size = steps[0].querySelectorAll('fieldset').length;
  if ([...data.keys()].length !== steps.length * size) return;
  const scores = document.querySelector('#scores')!;
  scores.replaceChildren();
  const values: number[] = [];
  const names = steps.map(step => step.getAttribute('aria-label')!);
  const legacy = size === 4;
  names.forEach((name, group) => {
    const answers = Array.from({ length: size }, (_, index) => Number(data.get('q' + (group * size + index))));
    const sum = answers.reduce((total, answer) => total + answer, 0);
    const percent = Math.round((sum - 3) / 12 * 100);
    values.push(sum);
    const row = document.createElement('article');
    row.className = 'result-row';
    const heading = document.createElement('h3');
    heading.textContent = name + ': ' + (legacy ? sum + '/20' : percent + '%');
    const meter = document.createElement('meter');
    meter.min = legacy ? 4 : 0;
    meter.max = legacy ? 20 : 100;
    meter.value = legacy ? sum : percent;
    meter.setAttribute('aria-label', heading.textContent);
    const text = document.createElement('p');
    text.textContent = legacy
      ? (sum < 10 ? 'Área para explorar y fortalecer' : sum < 15 ? 'Área en desarrollo' : 'Fortaleza percibida')
      : suggestions[group][answers.indexOf(Math.min(...answers))];
    row.append(heading, meter, text);
    scores.append(row);
  });
  if (!legacy) {
    const leaders = names.filter((_, index) => values[index] === Math.max(...values));
    const growth = names.filter((_, index) => values[index] === Math.min(...values));
    document.querySelector('#score-summary')!.textContent = leaders.length === names.length
      ? 'Los cuatro pilares obtuvieron el mismo índice. Elige cuál te interesa explorar primero.'
      : 'Fortaleza percibida: ' + leaders.join(', ') + '. Para fortalecer: ' + growth.join(', ') + '.';
  }
  form.hidden = true;
  result.hidden = false;
  result.focus();
  // Only the synthetic legacy build may use the 4–20 capture contract.
  if (legacy) document.dispatchEvent(new CustomEvent('power4:result', {
    detail: { spirit: values[0], mind: values[1], body: values[2], emotion: values[3] },
  }));
});
document.querySelector('#repeat')!.addEventListener('click',()=>{form.reset();result.hidden=true;document.querySelector('#scores')!.replaceChildren();form.hidden=false;current=0;showStep();document.dispatchEvent(new Event('power4:reset'))});
</script>
