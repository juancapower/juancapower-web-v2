---
import Platform from '../layouts/Platform.astro';import rawQuestions from '../data/power4.json';import {booking} from '../data/site';
const questions=rawQuestions as [string,string[]][];
---
<Platform title="Mapa POWER 4 · Evaluación de Alineación Personal" description="Dieciséis afirmaciones de autopercepción con resultados locales y sin registro."><section class="platform-hero presence-wrap test-intro"><div><p class="presence-kicker">AUTOPERCEPCIÓN · SIN REGISTRO</p><h1>Tu momento.<br/><span>Tu mapa POWER 4.</span></h1><p>Considera las últimas dos semanas. Responde de 1 (muy poco) a 5 (mucho). Es una herramienta de reflexión, no un diagnóstico ni un instrumento científico validado.</p><a class="presence-button" href={booking}>Reservar orientación sin hacer el test ↗</a></div></section><section class="platform-section platform-light"><div class="presence-wrap test-questions"><noscript><p>El cálculo necesita JavaScript local. No se envían respuestas; puedes reservar orientación directamente desde el enlace de arriba.</p></noscript><form id="power-form" method="dialog" autocomplete="off" novalidate><div id="step-progress" hidden><p id="step-label" tabindex="-1"></p><progress id="step-meter" max="4" value="1" aria-label="Progreso de la evaluación"></progress><p id="step-error" role="alert"></p></div>{questions.map(([dimension,items],group)=><section class="power-step" aria-label={dimension}><h2>{dimension}</h2>{items.map((question,index)=><fieldset><legend>{question}</legend>{[1,2,3,4,5].map(value=><label class="test-answer"><input type="radio" name={`q${group*4+index}`} value={value} required/>{value}</label>)}</fieldset>)}</section>)}<div class="step-actions"><button id="previous-step" class="presence-button" type="button" hidden>Anterior</button><button id="next-step" class="presence-button" type="button" hidden>Siguiente</button><button id="show-map" class="presence-button" type="submit" disabled>Ver mi mapa POWER 4</button></div></form><section id="power-result" hidden tabindex="-1" aria-labelledby="result-title"><h2 id="result-title">Tu mapa de hoy</h2><p>Rangos orientativos no clínicos ni psicométricamente validados: 4–9, área para explorar; 10–14, en desarrollo; 15–20, fortaleza percibida. No definen quién eres ni predicen resultados.</p><div id="scores"></div><p>Elige una dimensión y pregúntate: ¿qué acción pequeña y realista quiero explorar esta semana?</p><h3>¿Quieres convertir este mapa en un plan personalizado?</h3><a class="presence-button" href={booking}>Agenda tu sesión POWER 4 ↗</a><p><button id="repeat" class="presence-button" type="button">Repetir el test</button></p></section><p>Las respuestas se procesan solo en esta página y se eliminan al recargar. No se envían ni guardan. La reserva siempre es opcional y directa.</p></div></section></Platform>
<script>
const form=document.querySelector<HTMLFormElement>('#power-form')!;
const result=document.querySelector<HTMLElement>('#power-result')!;
const steps=[...form.querySelectorAll<HTMLElement>('.power-step')];
const previous=document.querySelector<HTMLButtonElement>('#previous-step')!;
const next=document.querySelector<HTMLButtonElement>('#next-step')!;
const submit=document.querySelector<HTMLButtonElement>('#show-map')!;
const label=document.querySelector<HTMLElement>('#step-label')!;
const error=document.querySelector<HTMLElement>('#step-error')!;
let current=0;
form.reset();submit.disabled=false;
function showStep(focus=true){steps.forEach((s,i)=>s.hidden=i!==current);previous.hidden=current===0;next.hidden=current===3;submit.hidden=current!==3;label.textContent=`Paso ${current+1} de 4 · ${steps[current].getAttribute('aria-label')}`;(document.querySelector('#step-meter') as HTMLProgressElement).value=current+1;error.textContent='';if(focus)label.focus()}
function validate(){const fields=[...steps[current].querySelectorAll('fieldset')];const missing=fields.find(f=>!f.querySelector('input:checked'));if(missing){error.textContent='Responde las cuatro afirmaciones para continuar. Puedes volver al paso anterior sin perder tus respuestas.';missing.querySelector('input')!.focus();return false}return true}
document.querySelector<HTMLElement>('#step-progress')!.hidden=false;showStep(false);
next.addEventListener('click',()=>{if(validate()){current++;showStep()}});
previous.addEventListener('click',()=>{current--;showStep()});
form.addEventListener('submit',e=>{e.preventDefault();if(!validate())return;const data=new FormData(form);if([...data.keys()].length!==16)return;const scores=document.querySelector('#scores')!;scores.replaceChildren();['Espíritu','Mente','Cuerpo','Emoción'].forEach((name,group)=>{let sum=0;for(let i=0;i<4;i++)sum+=Number(data.get(`q${group*4+i}`));const row=document.createElement('div');row.className='result-row';const heading=document.createElement('h3');heading.textContent=`${name}: ${sum}/20`;const meter=document.createElement('meter');meter.min=4;meter.max=20;meter.value=sum;meter.setAttribute('aria-label',`${name}: ${sum} de 20`);const text=document.createElement('p');text.textContent=sum<10?'Área para explorar y fortalecer':sum<15?'Área en desarrollo':'Fortaleza percibida';row.append(heading,meter,text);scores.append(row)});form.hidden=true;result.hidden=false;result.focus()});
document.querySelector('#repeat')!.addEventListener('click',()=>{form.reset();result.hidden=true;document.querySelector('#scores')!.replaceChildren();form.hidden=false;current=0;showStep()});
</script>
